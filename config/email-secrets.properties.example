# Template for config/email-secrets.properties
# Group 10 - Server Health Monitoring System
#
# Copy this file to email-secrets.properties and fill in the placeholders.
# The real file is listed in .gitignore so a live App Password is never
# committed; this template is safe to keep in the repository.

smtp.username=PASTE_SENDER_GMAIL_ADDRESS_HERE
smtp.appPassword=PASTE_GMAIL_APP_PASSWORD_HERE
smtp.recipient=PASTE_RECIPIENT_EMAIL_HERE

smtp.host=smtp.gmail.com
smtp.port=587
smtp.starttls=true
smtp.auth=true
